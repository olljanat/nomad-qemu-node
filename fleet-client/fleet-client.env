# BurFleet client configuration. Copy to /data/config/fleet-client.env and
# run: systemctl restart fleet-client
FLEET_MANAGER_URL=https://fleet-manager.example.com
# Standalone group and environment of this node in BurFleet
FLEET_GROUP=nomad-qemu
FLEET_ENVIRONMENT=production
# Only when the group + environment is protected with htpasswd
#FLEET_USERNAME=nomad-qemu-production
#FLEET_PASSWORD=password
#FLEET_CA_CERT=/data/config/fleet-ca.pem

# Local Nomad agent, used to report the node status and to drain the node
# before maintenance. The token needs node:write and namespace read access.
NOMAD_ADDR=https://localhost:4646
NOMAD_CACERT=/etc/nomad.d/tls/nomad-agent-ca.pem
NOMAD_TOKEN=00000000-0000-0000-0000-000000000000
#FLEET_NOMAD_DRAIN_DEADLINE=1h
